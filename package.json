{
  "name": "adviserz-be",
  "version": "0.1.0",
  "private": true,
  "description": "Adviserz backend API (web + mobile)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate:up",
    "db:migrate:undo": "tsx src/db/cli.ts migrate:down",
    "db:migrate:undo:all": "tsx src/db/cli.ts migrate:down:all",
    "db:migrate:status": "tsx src/db/cli.ts migrate:status",
    "db:seed": "tsx src/db/cli.ts seed:up",
    "db:seed:status": "tsx src/db/cli.ts seed:status",
    "db:migrate:prod": "node dist/db/cli.js migrate:up",
    "db:seed:prod": "node dist/db/cli.js seed:up",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "maintenance:cleanup": "tsx src/db/cli.ts maintenance:cleanup",
    "maintenance:cleanup:prod": "node dist/db/cli.js maintenance:cleanup"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sequelize": "6.37.8",
    "socket.io": "4.8.4",
    "umzug": "3.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
