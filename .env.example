# -----------------------------------------------------------------------------
# Adviserz API — environment variables
# Copy to `.env` for local development. NEVER commit a real `.env`.
# In production, inject these from your secrets manager; no file is read.
# Every variable is validated at startup (src/config/env.ts).
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api/v1
# Number of reverse-proxy hops in front of the app (0 = none, 1 = one load balancer)
TRUST_PROXY=0

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adviserz
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_LOG_SQL=false

# Web clients (comma-separated exact origins). Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Parent domain when API and web app are on sibling subdomains (e.g. .adviserz.com)
COOKIE_DOMAIN=
# Must be true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=false
# strict/lax when web app and API share a site (app.adviserz.com + api.adviserz.com);
# none only for different sites, and then COOKIE_SECURE must be true.
COOKIE_SAMESITE=strict

# Tokens — generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ISSUER=adviserz-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
ADMIN_REFRESH_TOKEN_TTL_HOURS=12
# Reuse of a just-rotated refresh token within this window = benign race (409, session kept);
# later reuse = theft (session revoked). 0 = strict.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# Maintenance: purge ended sessions and old OTP records
# Interval for the in-process job (0 = disabled; then run `npm run maintenance:cleanup:prod` from a scheduler)
CLEANUP_INTERVAL_MINUTES=60
AUTH_DATA_RETENTION_DAYS=30

# OTP / verification
OTP_HMAC_SECRET=
# "static" = no real delivery, fixed code below. Forbidden in production.
SMS_PROVIDER=static
EMAIL_PROVIDER=static
STATIC_OTP_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
VERIFICATION_TOKEN_TTL_SECONDS=900

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Per-IP rate limits, requests per 15 minutes (in-memory; use a shared store when running >1 instance)
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=20
RATE_LIMIT_ADMIN_AUTH_MAX=10

# Super admin — read only by `npm run db:seed`. Remove the password afterwards.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
